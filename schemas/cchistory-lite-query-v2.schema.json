{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchistory.dev/schemas/cchistory-lite-query-v2.schema.json",
  "title": "CC History Lite batch query request",
  "type": "object",
  "required": ["schema", "operations"],
  "properties": {
    "schema": { "const": "cchistory-lite-query/v2" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/search" },
          { "$ref": "#/$defs/read" },
          { "$ref": "#/$defs/session" },
          { "$ref": "#/$defs/replies" },
          { "$ref": "#/$defs/latest" },
          { "$ref": "#/$defs/list" }
        ]
      }
    }
  },
  "$defs": {
    "read": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "oneOf": [
        {
          "required": [
            "session_ref"
          ],
          "not": {
            "required": [
              "turn_ref"
            ]
          }
        },
        {
          "required": [
            "turn_ref"
          ],
          "not": {
            "required": [
              "session_ref"
            ]
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "read"
        },
        "session_ref": {
          "type": "string",
          "minLength": 1
        },
        "turn_ref": {
          "type": "string",
          "minLength": 1
        },
        "max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 64000,
          "default": 8000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "query"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "search"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "project_ref": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "enum": [
            "authored",
            "conversation"
          ],
          "default": "authored"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 64000,
          "default": 8000
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "content": {
                "const": "conversation"
              }
            },
            "required": [
              "content"
            ]
          },
          "then": {
            "properties": {
              "limit": {
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "max_chars"
            ]
          },
          "then": {
            "properties": {
              "content": {
                "const": "conversation"
              }
            },
            "required": [
              "content"
            ]
          }
        }
      ]
    },
    "session": {
      "type": "object",
      "required": ["id", "kind", "refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "session" },
        "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "replies": {
      "type": "object",
      "required": ["id", "kind", "turn_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "replies" },
        "turn_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "latest": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "latest" },
        "target": { "enum": ["sessions", "turns"] },
        "limit": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["id", "kind", "collection"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "list" },
        "collection": { "enum": ["sessions", "projects", "families"] },
        "limit": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
