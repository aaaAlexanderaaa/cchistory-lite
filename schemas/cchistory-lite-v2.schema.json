{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchistory.dev/schemas/cchistory-lite-v2.schema.json",
  "title": "CC History Lite compact read response",
  "type": "object",
  "required": ["schema", "kind", "content_trust", "projection_issues"],
  "properties": {
    "schema": { "const": "cchistory-lite/v2" },
    "kind": {
      "enum": [
        "sources", "projects", "sessions", "families", "turns", "search", "project_tree",
        "session_tree", "project_detail", "session_detail", "turn_detail", "source_detail", "stats"
      ]
    },
    "content_trust": { "const": "untrusted_history" },
    "projection_issues": { "type": "array", "items": { "$ref": "#/$defs/projectionIssue" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "families": { "type": "array", "items": { "$ref": "#/$defs/family" } },
    "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
    "results": { "type": "array" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "projectionIssue": {
      "type": "object",
      "required": ["code", "entity", "id", "detail"],
      "properties": {
        "code": { "type": "string" },
        "entity": { "type": "string" },
        "id": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "slot_id", "platform", "display_name", "base_dir", "sync_status", "error_message", "last_sync", "total_sessions", "total_turns"],
      "properties": {
        "id": { "type": "string" },
        "slot_id": { "type": "string" },
        "platform": { "type": "string" },
        "display_name": { "type": "string" },
        "base_dir": { "type": "string" },
        "sync_status": { "enum": ["healthy", "stale", "error"] },
        "error_message": { "$ref": "#/$defs/nullableString" },
        "last_sync": { "$ref": "#/$defs/nullableString" },
        "total_sessions": { "type": "integer", "minimum": 0 },
        "total_turns": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["project_id", "display_name", "slug", "linkage_state", "confidence", "link_reason", "primary_workspace_path", "repo_root", "repo_remote", "source_platforms", "session_count", "turn_count", "last_activity_at"],
      "properties": {
        "project_id": { "type": "string" },
        "display_name": { "type": "string" },
        "slug": { "type": "string" },
        "linkage_state": { "type": "string" },
        "confidence": { "type": "number" },
        "link_reason": { "type": "string" },
        "primary_workspace_path": { "$ref": "#/$defs/nullableString" },
        "repo_root": { "$ref": "#/$defs/nullableString" },
        "repo_remote": { "$ref": "#/$defs/nullableString" },
        "source_platforms": { "type": "array", "items": { "type": "string" } },
        "session_count": { "type": "integer", "minimum": 0 },
        "turn_count": { "type": "integer", "minimum": 0 },
        "last_activity_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": ["id", "source_id", "source_platform", "title", "created_at", "updated_at", "activity_at", "turn_count", "model_summary", "total_tokens", "storage_bytes", "delegated_child_count", "family_storage_bytes", "family_total_tokens", "working_directory", "source_session_id", "resume_command", "primary_project_id"],
      "properties": {
        "id": { "type": "string" },
        "source_id": { "type": "string" },
        "source_platform": { "type": "string" },
        "title": { "$ref": "#/$defs/nullableString" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "activity_at": { "type": "string" },
        "turn_count": { "type": "integer", "minimum": 0 },
        "model_summary": { "$ref": "#/$defs/nullableString" },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "storage_bytes": { "type": "integer", "minimum": 0 },
        "delegated_child_count": { "type": "integer", "minimum": 0 },
        "family_storage_bytes": { "type": "integer", "minimum": 0 },
        "family_total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "working_directory": { "$ref": "#/$defs/nullableString" },
        "source_session_id": { "$ref": "#/$defs/nullableString" },
        "resume_command": { "$ref": "#/$defs/nullableString" },
        "primary_project_id": { "$ref": "#/$defs/nullableString" }
      },
      "additionalProperties": false
    },
    "turn": {
      "type": "object",
      "required": ["id", "session_id", "source_id", "source_platform", "project_id", "submission_started_at", "last_context_activity_at", "authored_text", "link_state", "model", "total_tokens", "assistant_reply_count", "tool_call_count"],
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "source_id": { "type": "string" },
        "source_platform": { "$ref": "#/$defs/nullableString" },
        "project_id": { "$ref": "#/$defs/nullableString" },
        "submission_started_at": { "type": "string" },
        "last_context_activity_at": { "type": "string" },
        "authored_text": { "type": "string" },
        "link_state": { "type": "string" },
        "model": { "$ref": "#/$defs/nullableString" },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "assistant_reply_count": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": ["storage_bytes", "blob_count", "turn_count", "assistant_reply_count", "tool_call_count", "tool_success_count", "tool_error_count", "tool_pending_count", "input_tokens", "output_tokens", "cached_input_tokens", "reasoning_output_tokens", "total_tokens"],
      "properties": {
        "storage_bytes": { "type": "integer", "minimum": 0 },
        "blob_count": { "type": "integer", "minimum": 0 },
        "turn_count": { "type": "integer", "minimum": 0 },
        "assistant_reply_count": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_success_count": { "type": "integer", "minimum": 0 },
        "tool_error_count": { "type": "integer", "minimum": 0 },
        "tool_pending_count": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "required": ["parent_session_ref", "parent_source_session_id", "parent_title", "source_platform", "child_count", "parent", "combined", "children"],
      "properties": {
        "parent_session_ref": { "type": "string" },
        "parent_source_session_id": { "$ref": "#/$defs/nullableString" },
        "parent_title": { "$ref": "#/$defs/nullableString" },
        "source_platform": { "type": "string" },
        "child_count": { "type": "integer", "minimum": 0 },
        "parent": { "$ref": "#/$defs/stats" },
        "combined": { "$ref": "#/$defs/stats" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/delegatedChild" } }
      },
      "additionalProperties": false
    },
    "delegatedChild": {
      "type": "object",
      "required": ["id", "identity_kind", "child_session_ref", "agent_key", "title", "status", "created_at", "updated_at", "input_preview", "output_preview", "parent_tool_ref", "origin_paths", "stats"],
      "properties": {
        "id": { "type": "string" },
        "identity_kind": { "enum": ["session", "sidecar"] },
        "child_session_ref": { "$ref": "#/$defs/nullableString" },
        "agent_key": { "$ref": "#/$defs/nullableString" },
        "title": { "$ref": "#/$defs/nullableString" },
        "status": { "$ref": "#/$defs/nullableString" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "input_preview": { "$ref": "#/$defs/nullableString" },
        "output_preview": { "$ref": "#/$defs/nullableString" },
        "parent_tool_ref": { "$ref": "#/$defs/nullableString" },
        "origin_paths": { "type": "array", "items": { "type": "string" } },
        "stats": { "$ref": "#/$defs/stats" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
