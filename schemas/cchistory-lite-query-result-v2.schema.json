{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchistory.dev/schemas/cchistory-lite-query-result-v2.schema.json",
  "title": "CC History Lite batch query result",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "content_trust",
    "operations",
    "projection_issues",
    "read",
    "read_status"
  ],
  "properties": {
    "schema": {
      "const": "cchistory-lite-query-result/v2"
    },
    "kind": {
      "const": "query_result"
    },
    "content_trust": {
      "const": "untrusted_history"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "search",
              "session",
              "replies",
              "latest",
              "list",
              "read"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ]
          },
          "result": {
            "type": "object"
          },
          "error": {
            "type": "object"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "read"
                },
                "status": {
                  "const": "ok"
                }
              },
              "required": [
                "kind",
                "status"
              ]
            },
            "then": {
              "properties": {
                "result": {
                  "$ref": "#/$defs/evidenceRead"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        ]
      }
    },
    "projection_issues": {
      "type": "array"
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "directory_scope": {
          "type": [
            "object",
            "null"
          ]
        },
        "sources": {
          "type": "array"
        },
        "loss_audits": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "read_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "source_error_count",
        "loss_warning_count",
        "unknown_directory_sessions",
        "projection_issue_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_known_gaps",
            "partial",
            "unverified"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "loss_warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_directory_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "projection_issue_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prepared_at",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "prepared_at": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory",
            "source_ids"
          ],
          "properties": {
            "directory": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidenceRead": {
      "type": "object",
      "required": [
        "target",
        "revision",
        "messages",
        "shown",
        "total_messages",
        "returned_chars",
        "max_chars",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "target": {
          "type": "object"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "messages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "message_id",
              "session_id",
              "turn_id",
              "role",
              "created_at",
              "text",
              "start",
              "end",
              "total_chars",
              "truncated"
            ],
            "properties": {
              "message_id": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "turn_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "created_at": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "total_chars": {
                "type": "integer",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "shown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "total_messages": {
          "type": "integer",
          "minimum": 0
        },
        "returned_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64000
        },
        "max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 64000
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
