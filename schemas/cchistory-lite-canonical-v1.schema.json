{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchistory.dev/schemas/cchistory-lite-canonical-v1.schema.json",
  "title": "CC History Lite canonical read response",
  "type": "object",
  "required": ["schema", "kind", "projection_issues"],
  "properties": {
    "schema": { "const": "cchistory-lite-canonical/v1" },
    "kind": { "type": "string" },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prepared_at",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "prepared_at": {
          "type": "string"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directory",
            "source_ids"
          ],
          "properties": {
            "directory": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "read_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "source_error_count",
        "loss_warning_count",
        "unknown_directory_sessions",
        "projection_issue_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_known_gaps",
            "partial",
            "unverified"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "loss_warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_directory_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "projection_issue_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "projection_issues": { "type": "array" }
  },
  "additionalProperties": true
}
