{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cchistory.dev/schemas/cchistory-lite-query-result-v1.schema.json",
  "title": "CC History Lite batch query result",
  "type": "object",
  "required": ["schema", "kind", "content_trust", "operations", "projection_issues"],
  "properties": {
    "schema": { "const": "cchistory-lite-query-result/v1" },
    "kind": { "const": "query_result" },
    "content_trust": { "const": "untrusted_history" },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["search", "session", "replies"] },
          "status": { "enum": ["ok", "error"] },
          "result": { "type": "object" },
          "error": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "projection_issues": { "type": "array" }
  },
  "additionalProperties": false
}
