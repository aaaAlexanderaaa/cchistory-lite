{
  "name": "@cchistory/lite-tui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cchistory-lite-tui": "./dist/bin.js"
  },
  "scripts": {
    "build": "pnpm --filter @cchistory/live-runtime build && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/bin.js', 0o755)\"",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --import ../../scripts/install-node-sqlite-warning-filter.mjs --test dist/*.test.js"
  },
  "dependencies": {
    "@cchistory/domain": "workspace:*",
    "@cchistory/live-runtime": "workspace:*"
  }
}
