{
  "name": "@cchistory/lite-cli",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cchistory-lite": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --filter @cchistory/live-runtime build && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test dist/*.test.js"
  },
  "dependencies": {
    "@cchistory/domain": "workspace:*",
    "@cchistory/live-runtime": "workspace:*"
  }
}
